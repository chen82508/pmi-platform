# Copy to .env and fill in. Every value here has a working local default
# unless marked REQUIRED.

# ─── Database ────────────────────────────────────────────────────────────────
PMI_DB_HOST=localhost
PMI_DB_PORT=5432
# Host port the compose Postgres is published on (loopback only).
PMI_DB_HOST_PORT=5433
PMI_DB_NAME=pmi
PMI_DB_USER=pmi
PMI_DB_PASSWORD=pmi
PMI_DB_SSL=false

# ─── LLM providers ───────────────────────────────────────────────────────────
# Factor models are bound per factor in the model registry (`pmi-core models`).
# `gpt-*` ids use OpenAI (or any OpenAI-compatible endpoint via PMI_LLM_BASE_URL);
# `ollama/*` ids use the local ollama service. With neither configured the
# pipeline falls back to the deterministic stub evaluator.
OPENAI_API_KEY=
PMI_LLM_BASE_URL=
PMI_LLM_API_KEY=
PMI_OLLAMA_BASE_URL=http://localhost:11434/v1
PMI_LLM_CONCURRENCY=8
# Embeddings power the semantic selector and the Tier 0 pre-filter. Empty =
# off (both fail open). After `just ollama-up`, set ollama/nomic-embed-text.
PMI_ACTIVE_EMBEDDING_MODEL=

# ─── MLflow (prompt registry + run tracking mirror; optional) ────────────────
PMI_MLFLOW_TRACKING_URI=http://localhost:5500
PMI_MLFLOW_ENABLED=true

# ─── pmi-api ─────────────────────────────────────────────────────────────────
# When true every non-public route needs X-API-Key (mint one with
# `pmi-core keys create`).
PMI_API_REQUIRE_AUTH=false
PMI_API_CORS_ORIGINS=http://localhost:3000
# Port the API listens on inside its container, and the host port compose
# publishes it on.
PMI_API_PORT=8000
PMI_API_HOST_PORT=8001
# Ask endpoint answer model: `local` (ollama), `chatgpt` (OpenAI) or a full id.
PMI_API_ASK_MODEL=local

# ─── pmi-web ─────────────────────────────────────────────────────────────────
PMI_WEB_PORT=3000
NEXT_PUBLIC_PMI_API_URL=http://localhost:8001
PMI_API_URL=http://pmi-api:8000
# Server-side only; never exposed to the browser.
PMI_API_KEY=

# ─── Failure notifications (pmi-notify → Slack; empty = log only) ────────────
SLACK_WEBHOOK_URL=
SLACK_ENVIRONMENT=development

# ─── Weekly report email (empty host = log the digest and skip sending) ──────
PMI_SMTP_HOST=
PMI_SMTP_PORT=587
PMI_SMTP_USER=
PMI_SMTP_PASSWORD=
PMI_SMTP_STARTTLS=true
PMI_EMAIL_FROM=PMI Platform <updates@localhost>
PMI_PUBLIC_WEB_URL=http://localhost:3000
